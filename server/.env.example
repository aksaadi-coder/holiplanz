ANTHROPIC_API_KEY=sk-ant-your-key-here
BACKEND_PORT=3001
# Origin allowed to call this backend (defaults to the Vite dev server if unset)
CORS_ORIGIN=http://localhost:5173
# Optional: if set, every /api request must send a matching X-Access-Code header.
# Leave unset for normal local dev. Set this in Vercel before sharing a public link
# so random visitors can't spend your Anthropic credits.
# ACCESS_CODE=choose-a-passphrase
# Optional: ISO timestamp after which ACCESS_CODE stops working entirely (all /api
# requests get a "link expired" response, regardless of the code). Useful for a
# time-boxed share link, e.g. 72 hours from when you set it.
# ACCESS_CODE_EXPIRES_AT=2026-07-07T16:00:00.000Z
