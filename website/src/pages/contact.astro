---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import PageBanner from '../components/PageBanner.astro';
import { site } from '../data/site';

/**
 * One address, set as display type.
 *
 * An earlier revision split this into three cards — general, press, privacy.
 * It was cut: three addresses is a routing decision a visitor shouldn't have to
 * make, and for a pre-launch team this size the volume doesn't justify it.
 * Don't reintroduce the cards. If press or data-request routing is ever needed,
 * alias those addresses server-side and keep one on the page.
 */
---

<Base
  title="Contact us — Holiplanz"
  description="One inbox, read by a person. Questions about the app, press enquiries and data requests all come to hello@holiplanz.com."
>
  <PageBanner title="Say hello." titleSize="clamp(42px, 5.2vw, 66px)">
    Small team, real inbox. Whatever it's about, a person reads it.
  </PageBanner>

  <Band padTop={88} padBottom={96}>
    <div class="wrap write">
      <span class="label">Write to us</span>
      <a class="write__email" href={`mailto:${site.generalEmail}`}>{site.generalEmail}</a>
      <p class="write__body">
        Questions about the app, press enquiries, data requests — all of it comes here. You'll
        usually hear back in a day or two.
      </p>
      <p class="write__aside">
        Before you write, <a class="write__link" href="/support">the support page</a> covers
        pricing, launch timing and how the Trip Passport works.
      </p>
    </div>
  </Band>
</Base>

<style>
  .write {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  /* The address is the page. Coral is earned here — it's the single action the
     site offers, and it's set at display scale to say so. */
  .write__email {
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--accent);
    /* Long enough to overflow a phone otherwise. */
    word-break: break-word;
  }

  .write__email:hover {
    color: var(--hp-coral-vivid);
  }

  .write__body {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted-strong);
    max-width: 520px;
  }

  .write__aside {
    margin: 8px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-faint);
    max-width: 520px;
  }

  .write__link {
    border-bottom: 1px solid rgba(0, 0, 0, 0.25);
  }

  .write__link:hover {
    border-bottom-color: var(--accent);
  }
</style>
