---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import PageBanner from '../components/PageBanner.astro';
import ScreenshotFrame from '../components/ScreenshotFrame.astro';
import Stamp from '../components/Stamp.astro';
import passport from '../assets/screenshots/passport-screen-v2.png';

const principles = [
  {
    number: 'N° 01',
    title: 'One decision at a time',
    text: 'Every screen asks for one thing. No dashboards, no forty-field forms, nothing to configure before you begin.',
  },
  {
    number: 'N° 02',
    title: 'Three options, not three hundred',
    text: "Choice past a point is just work. We do the comparing and show you the shortlist we'd actually book.",
  },
  {
    number: 'N° 03',
    title: "Honest, even when it's blank",
    text: 'Your passport records what you did, not what you meant to do. Nothing is inflated and nothing skipped counts against you.',
  },
];
---

<Base
  title="About — Holiplanz"
  description="Planning a trip became a second job. Holiplanz exists to give that part back — and to be the app you stop looking at once you're on the trip."
>
  <PageBanner
    title="Planning a trip became a second job."
    titleSize="clamp(44px, 5.6vw, 74px)"
  >
    Forty open tabs. Six review sites that disagree. A spreadsheet nobody asked for. Somewhere in
    there the trip you were excited about turned into admin — and the excitement went with it.
  </PageBanner>

  {/* The thesis, at reading size. */}
  <Band padTop={88} padBottom={80}>
    <div class="intent">
      <p class="intent__lead">
        Holiplanz exists to give that part back. You say where you're going. We hand you a complete
        plan — days in order, places worth staying, what it costs, what to know before you land.
      </p>
      <p class="intent__follow">
        Then you close the app and go. That last bit is the whole point — the app that plans your
        trip should be the app you stop looking at once you're on it.
      </p>
    </div>
  </Band>

  <Band tone="panel" bordered padTop={88} padBottom={88}>
    <div class="wrap principles">
      <h2 class="h2 principles__heading">What we hold to.</h2>
      <div class="principles__grid">
        {
          principles.map((principle) => (
            <div class="principle">
              <span class="principle__number">{principle.number}</span>
              <h3 class="principle__title">{principle.title}</h3>
              <p class="principle__text">{principle.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Band>

  {/* Reuses the home page's framed-screenshot pattern and points back at it. */}
  <Band padTop={96} padBottom={96}>
    <div class="wrap passport">
      <div class="passport__copy">
        <span class="label">The bit we care most about</span>
        <h2 class="h2 passport__heading">You don't get a stamp for planning.</h2>
        <p class="passport__text">
          Most travel apps reward you for using them. The Trip Passport only fills in when you
          actually go somewhere and say what you did — museums, meals, the walk you nearly talked
          yourself out of. It's the one part of Holiplanz you can't rush, and the part people keep.
        </p>
        <a class="passport__link" href="/#passport">See how the passport works →</a>
      </div>
      <div class="passport__media">
        <ScreenshotFrame
          src={passport}
          alt="A filled-in Holiplanz trip passport"
          maxWidth={360}
        />
      </div>
    </div>
  </Band>

  <Fragment slot="closing">
    <Band padTop={88} padBottom={72}>
      <div class="closing">
        <h2 class="h2 closing__heading">Plan less. Experience more.</h2>
        <Stamp variant="destination" label="iPhone & Android" sublabel="2026" size={170} />
      </div>
    </Band>
  </Fragment>
</Base>

<style>
  .intent {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Set at reading size rather than heading size — it's a statement, not a
     headline, and it earns its weight by being said plainly. */
  .intent__lead {
    margin: 0;
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.55;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  .intent__follow {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-muted-strong);
    text-wrap: pretty;
  }

  .principles {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .principles__heading {
    font-size: clamp(34px, 4vw, 52px);
    max-width: 620px;
  }

  /* The dividers are the 1px gap showing the border colour through, so three
     principles read as one ruled block. */
  .principles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1px;
    background: var(--border-default);
  }

  .principle {
    background: var(--bg-panel);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* The outer cells lose their outside padding so the text aligns with the
     band's own column rather than sitting inset from it. */
  .principle:first-child {
    padding-left: 0;
  }

  .principle:last-child {
    padding-right: 0;
  }

  .principle__number {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--accent);
  }

  .principle__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.1;
  }

  .principle__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-muted-strong);
  }

  .passport {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 72px;
    align-items: center;
  }

  .passport__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 520px;
  }

  .passport__heading {
    font-size: clamp(34px, 4.2vw, 54px);
  }

  .passport__text {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-muted-strong);
    text-wrap: pretty;
  }

  .passport__link {
    font-size: 16px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.25);
    padding-bottom: 2px;
    align-self: flex-start;
  }

  .passport__link:hover {
    border-bottom-color: var(--accent);
  }

  .passport__media {
    display: flex;
    justify-content: center;
  }

  .closing {
    max-width: 840px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 32px;
  }

  .closing__heading {
    font-size: clamp(34px, 4.4vw, 54px);
    text-wrap: balance;
  }
</style>
