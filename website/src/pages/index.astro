---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Hero from '../components/Hero.astro';
import StepBand from '../components/StepBand.astro';
import LiveDemo from '../components/LiveDemo.astro';
import Reel from '../components/Reel.astro';
import ScreenshotFrame from '../components/ScreenshotFrame.astro';
import PricingCard from '../components/PricingCard.astro';
import Stamp from '../components/Stamp.astro';

import homeFilled from '../assets/screenshots/08-home-filled.png';
import itineraryDay1 from '../assets/screenshots/15-itinerary-day1.png';
import mapCard from '../assets/screenshots/17-itinerary-map-card.png';
import tripInfo from '../assets/screenshots/20-itinerary-trip-info.png';
import stopDetail from '../assets/screenshots/19-itinerary-stop-detail.png';
import hotelDetail from '../assets/screenshots/24-itinerary-hotel-detail-9c141e8d.png';
import budget from '../assets/screenshots/21-itinerary-budget.png';
import preferences from '../assets/screenshots/22-itinerary-preferences.png';
import passport from '../assets/screenshots/passport-screen-v2.png';

/**
 * The home page. One long scroll.
 *
 * The narrative runs 01 You ask → 02 We plan → 03 Your days → the live demo →
 * 04 On the ground → 05 On your terms → 06 You come home, then pricing, the
 * closing stamp and the footer.
 *
 * The shape is deliberate: a conventional hero says what the product is, then
 * the page walks through a single worked example — three days in Lisbon, from
 * the first typed line to a stamped passport. The visitor is watching a
 * demonstration, with one exception: the live demo, which is the only place
 * they can touch the product.
 */

const groundScreens = [
  {
    image: mapCard,
    alt: 'The day map, expanded in the itinerary',
    caption: 'Every stop on one map, in walking order.',
  },
  {
    image: tripInfo,
    alt: 'Lisbon trip info — time, weather, currency',
    caption: 'Time, weather, currency, plug type, tipping.',
  },
  {
    image: stopDetail,
    alt: 'A single stop, in detail',
    caption: 'Each stop, with what to know before you arrive.',
  },
  {
    image: hotelDetail,
    alt: 'Casa Amarela — a hotel detail screen',
    caption: "Where you'll stay, down to the room.",
  },
];

const terms = [
  {
    title: 'The budget, before you commit',
    text: "Stays, food, getting around and what you'll pay to enter — totalled, and broken down so you can see what to cut.",
  },
  {
    title: 'Your preferences, kept',
    text: 'Pace, budget band, how you like to eat and get around. Change one and the plan follows — and it remembers next time.',
  },
];

const tiers = [
  {
    tier: 'Free',
    price: '$0',
    features: [
      { text: 'One basic itinerary' },
      { text: 'View and save trips' },
      { text: 'Manual edits only' },
      { text: 'Passport preview — locked', muted: true },
    ],
  },
  {
    // No coral label and no "new" tag: coral is earned, and a price tier
    // doesn't earn it. The inset ring already carries the emphasis.
    tier: 'Trip Pass',
    price: '$19',
    priceSuffix: 'one-time',
    featured: true,
    features: [
      { text: 'Unlimited AI editing' },
      { text: 'Offline & PDF export' },
      { text: 'Earn your Trip Passport' },
      { text: 'Budget planner & tips' },
    ],
  },
  {
    tier: 'Premium',
    price: '$49',
    priceSuffix: '/ year',
    features: [
      { text: 'Everything in Trip Pass' },
      { text: 'Your passport collection' },
      { text: 'Priority feature access' },
      { text: 'Unlimited trips, all year' },
    ],
  },
];
---

<Base
  title="Holiplanz — Plan less. Experience more."
  description="Tell us where you're going and get a complete, ready-to-book itinerary — days, stays, maps and costs — in about thirty seconds. Coming soon on iPhone and Android."
>
  <Hero />

  {/*
    The framing statement. Load-bearing: it tells the visitor the sections that
    follow are a demonstration rather than an invitation. Do not cut it.
  */}
  <Band padTop={96} padBottom={0}>
    <div class="framing wrap">
      <span class="label">A worked example</span>
      <h2 class="h2 framing__heading">
        Here's one trip to Lisbon, from a single line to a finished passport.
      </h2>
      <p class="lede framing__lede">Five steps, exactly as they happen in the app.</p>
    </div>
  </Band>

  {/* 01 */}
  <StepBand
    id="flow"
    label="01 · You ask"
    heading="One line is the whole brief."
    image={homeFilled}
    alt="Holiplanz home screen with Lisbon entered"
    imageSide="right"
    padTop={72}
    padBottom={96}
  >
    <Fragment slot="body">
      Where, when, and roughly how you like to travel. Pick a style or type your own — "hiking
      with kids" works as well as anything from the list.
    </Fragment>
  </StepBand>

  {/*
    02. The spinning stamp ring stands in for a loading spinner — it is the
    brand's signature motif, and the wait is used to teach you something about
    where you're going.
  */}
  <Band tone="dark" padTop={104} padBottom={104}>
    <div class="plan">
      <Stamp variant="ring" size={120} spinning>
        <img class="plan__pin" src="/assets/brand/stamp-pin.png" alt="" width="40" height="40" />
      </Stamp>
      <span class="label">02 · We plan</span>
      <h2 class="plan__quote">
        "Did you know — Lisbon is the capital and largest city of Portugal, on the Atlantic coast
        where the river Tagus meets the sea."
      </h2>
      <p class="plan__body">
        Thirty to forty seconds. The wait teaches you something about where you're going, instead
        of spinning.
      </p>
    </div>
  </Band>

  {/* 03 — mirrors 01, screenshot on the left */}
  <StepBand
    label="03 · Your days, decided"
    heading="Three days, already in order."
    image={itineraryDay1}
    alt="Day one of the Lisbon itinerary"
    imageSide="left"
    padTop={104}
    padBottom={96}
  >
    <Fragment slot="body">
      Castle at nine, the viewpoint before lunch, fado in Alfama after dark. Drag anything, or
      just ask — "swap lunch for something local" — and the day rebuilds itself around it.
    </Fragment>
    <ul class="days">
      <li>Where you'll stay — three options, not three hundred</li>
      <li>Before you go — twelve things, ticked off</li>
      <li>Trip budget — €1,240, broken down honestly</li>
    </ul>
  </StepBand>

  {/*
    The live demo. The only place a visitor touches the product, so the copy
    around it describes exactly what the build renders — arrows and a chat bar,
    not a drag handle.
  */}
  <Band padTop={96} padBottom={96}>
    <div class="wrap demo-band">
      <div class="demo-band__copy">
        <span class="label">Try it · Nothing to install</span>
        <h2 class="h2 demo-band__heading">Ask for a change. Or move it yourself.</h2>
        <p class="demo-band__body">
          Two ways to reshape a day, and neither is a form. Type what you'd rather do and the plan
          rewrites itself — or move a card up or down yourself. This is the real thing, working
          right here.
        </p>
        <div class="demo-band__hints">
          <span>Use a card's arrows to reorder the day</span>
          <span>Or type in the chat bar — try "lunch", "morning" or "outdoors"</span>
        </div>
      </div>
      <div class="demo-band__mock">
        <LiveDemo />
      </div>
    </div>
  </Band>

  {/*
    04. Full-bleed so the reel can run past the content box; the header stays
    inside it and centred.
  */}
  <Band tone="panel" bordered fullBleed padTop={96} padBottom={96}>
    <div class="wrap ground__head">
      <span class="label">04 · On the ground</span>
      <h2 class="h2 ground__heading">Everything you'd have googled anyway.</h2>
    </div>
    <Reel items={groundScreens} label="Itinerary screens, scroll sideways" />
  </Band>

  {/*
    05. Budget and preferences were cards in §04 and were pulled out: they are
    about money and control, not about what you'd google.
  */}
  <Band padTop={104} padBottom={104}>
    <div class="wrap terms">
      <div class="terms__copy">
        <span class="label">05 · On your terms</span>
        <h2 class="h2 terms__heading">What it costs, and how you like to travel.</h2>
        <p class="terms__body">
          The two things a plan is useless without: an honest number, and the sense that it was
          built for you rather than for everyone.
        </p>
        <div class="terms__rows">
          {
            terms.map((entry) => (
              <div class="terms__row">
                <h3 class="terms__rowTitle">{entry.title}</h3>
                <p class="terms__rowText">{entry.text}</p>
              </div>
            ))
          }
        </div>
      </div>
      {/*
        flex-basis 480 on the column and 220 on each frame: a smaller basis lets
        one frame wrap and the section grows taller, and `flex: 1 1 0` lets them
        collapse to a sliver. align-items must stay flex-start or the row's
        default stretch silently overrides the frames' aspect-ratio.
      */}
      <div class="terms__media">
        <ScreenshotFrame
          src={budget}
          alt="Lisbon trip budget"
          maxWidth={null}
          radius={28}
          ratio={0.462}
          class="terms__frame"
        />
        <ScreenshotFrame
          src={preferences}
          alt="Adjusting trip preferences"
          maxWidth={null}
          radius={28}
          ratio={0.462}
          class="terms__frame"
        />
      </div>
    </div>
  </Band>

  {/*
    06. The Trip Passport is the product's signature emotional feature: stamps
    are earned only for what you actually did, and what you skipped stays
    visibly blank. The copy's honesty about that is the point of the section.
  */}
  <StepBand
    id="passport"
    tone="dark"
    label="06 · You come home"
    heading="The only souvenir that fills itself in."
    headingSize="clamp(40px, 5vw, 66px)"
    bodySize={19}
    copyGap={24}
    image={passport}
    alt="A London family getaway trip passport with its coral admitted stamp"
    imageSide="right"
    imageMaxWidth={400}
    padTop={112}
    padBottom={112}
  >
    <Fragment slot="body">
      Say what you actually did and the passport stamps itself — museums, food, the walk you
      almost skipped. What you missed stays blank. That's the point.
    </Fragment>
  </StepBand>

  {/* Pricing */}
  <Band id="pricing" padTop={104} padBottom={104}>
    <div class="pricing wrap">
      <div class="pricing__head">
        <span class="label">Pricing</span>
        <h2 class="h2 pricing__heading">Your first journey is on us.</h2>
        <p class="lede">
          Full access to every feature, once, on the house. After that, pick whichever suits how
          often you travel.
        </p>
      </div>
      <div class="pricing__grid">
        {tiers.map((tier) => <PricingCard {...tier} />)}
      </div>
    </div>
  </Band>

  {/*
    Closing. Mounted into the layout's dark wrapper so it runs continuously into
    the footer. The stamp is the launch announcement — it should read as
    something pressed onto the page, not as footer small print.
  */}
  <Fragment slot="closing">
    <Band padTop={96} padBottom={80}>
      <div class="closing">
        <h2 class="h2 closing__heading">That was one scroll. The app does it in thirty seconds.</h2>
        <Stamp
          variant="destination"
          label="iPhone & Android"
          sublabel="Coming soon · 2026"
          size={180}
        />
      </div>
    </Band>
  </Fragment>
</Base>

<style>
  /* ---- framing ---- */
  .framing {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .framing__heading {
    font-size: clamp(34px, 4.2vw, 52px);
    line-height: 1.05;
    max-width: 820px;
    text-wrap: balance;
  }

  .framing__lede {
    max-width: 520px;
  }

  /* ---- 02 · we plan ---- */
  .plan {
    max-width: 1000px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 36px;
  }

  .plan__pin {
    width: 40px;
    height: auto;
    filter: invert(1);
  }

  .plan__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
    max-width: 820px;
    text-wrap: pretty;
    color: var(--text-primary);
  }

  .plan__body {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 520px;
  }

  /* ---- 03 · your days ---- */
  .days {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    color: var(--text-list);
  }

  /* ---- live demo ---- */
  .demo-band {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  .demo-band__copy {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 480px;
  }

  .demo-band__heading {
    font-size: clamp(38px, 4.6vw, 58px);
  }

  .demo-band__body {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-muted-strong);
    text-wrap: pretty;
  }

  .demo-band__hints {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 8px;
    font-size: 16px;
    color: var(--text-list);
  }

  .demo-band__mock {
    flex: 1 1 340px;
    display: flex;
    justify-content: center;
    max-width: 420px;
  }

  /* ---- 04 · on the ground ---- */
  /* The band is full-bleed so the reel can run past the 1240px column; the
     header puts the gutter back for itself. */
  .ground__head {
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .ground__heading {
    font-size: clamp(38px, 4.6vw, 58px);
    max-width: 760px;
  }

  /* ---- 05 · on your terms ---- */
  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }

  .terms__copy {
    flex: 1 1 300px;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .terms__heading {
    font-size: clamp(36px, 4.4vw, 54px);
  }

  .terms__body {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-muted-strong);
    text-wrap: pretty;
  }

  .terms__rows {
    margin-top: 12px;
    border-top: 1px solid var(--border-default);
  }

  .terms__row {
    padding: 20px 0;
    border-bottom: 1px solid var(--border-default);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .terms__rowTitle {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.15;
  }

  .terms__rowText {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-muted-strong);
  }

  .terms__media {
    flex: 1 1 480px;
    display: flex;
    justify-content: center;
    /* Must stay flex-start: the default stretch overrides the frames'
       aspect-ratio and they come out different heights. */
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .terms__media :global(.terms__frame) {
    flex: 1 1 220px;
    max-width: 340px;
  }

  /* ---- pricing ---- */
  .pricing {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .pricing__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 640px;
  }

  .pricing__heading {
    font-size: clamp(38px, 4.6vw, 58px);
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 20px;
    align-items: stretch;
  }

  /* ---- closing ---- */
  .closing {
    max-width: 840px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 32px;
  }

  .closing__heading {
    font-size: clamp(38px, 4.6vw, 58px);
    text-wrap: balance;
  }
</style>
