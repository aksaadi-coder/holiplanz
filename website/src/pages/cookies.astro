---
import LegalPage from '../layouts/LegalPage.astro';
import DocSection from '../components/DocSection.astro';
import DocContact from '../components/DocContact.astro';
import { site } from '../data/site';

const rows = [
  {
    kind: 'Strictly necessary',
    status: 'No consent needed',
    text: "Keeps the site working — security, load balancing, and remembering your cookie choice so we don't ask twice.",
  },
  {
    kind: 'Analytics',
    status: 'Optional — off until you agree',
    text: "Aggregated counts of which pages people read, so we know what's worth writing more of. No names, no cross-site tracking.",
  },
  {
    kind: 'Advertising',
    status: 'None',
    accent: true,
    text: "We don't run ads and we don't set advertising or profiling cookies.",
  },
];
---

<LegalPage
  title="Cookies — Holiplanz"
  description="The few cookies holiplanz.com sets, what each is for, and how to change your mind. No advertising network is involved."
  heading="Cookies"
  draftNote="The list below must be completed with the cookies your build actually sets."
>
  <Fragment slot="lede">
    This site uses very few cookies. None of them follow you anywhere, and there's no advertising
    network involved.
  </Fragment>

  <DocSection heading="What a cookie is">
    <p>
      A small file a site stores on your device so it can remember something between visits —
      whether you're signed in, or which choices you've already made.
    </p>
  </DocSection>

  <section class="cookieTable">
    <h2 class="cookieTable__heading">What we set</h2>
    <div class="cookieTable__rows">
      {
        rows.map((row) => (
          <div class="cookieRow">
            <div class="cookieRow__head">
              <span class="cookieRow__kind">{row.kind}</span>
              <span class:list={['cookieRow__status', { 'cookieRow__status--accent': row.accent }]}>
                {row.status}
              </span>
            </div>
            <span class="cookieRow__text">{row.text}</span>
          </div>
        ))
      }
    </div>
  </section>

  <DocSection heading="Changing your mind">
    <p>
      You can withdraw consent for the optional ones at any time, and clear or block cookies
      entirely in your browser settings. The strictly necessary ones can't be turned off without
      breaking the site, but they don't identify you.
    </p>
  </DocSection>

  <DocSection heading="The app">
    <p>
      This page covers the website. The Holiplanz app doesn't use cookies — how it handles your
      information is set out in the <a href="/privacy">privacy notice</a>.
    </p>
  </DocSection>

  <DocContact label="Ask us about this" email={site.privacyEmail} />
</LegalPage>

<style>
  .cookieTable {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cookieTable__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.15;
  }

  /* Hairline dividers drawn by the 1px grid gap showing the border colour
     through — no borders on the rows themselves, so nothing doubles up. */
  .cookieTable__rows {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border-default);
    border-top: 1px solid var(--border-default);
    border-bottom: 1px solid var(--border-default);
  }

  .cookieRow {
    background: var(--bg-primary);
    padding: 22px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cookieRow__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
  }

  .cookieRow__kind {
    font-size: 17px;
    font-weight: 600;
  }

  .cookieRow__status {
    font-size: var(--type-caption-size);
    color: var(--text-secondary);
  }

  /* "None" is worth the accent — it's the answer people are looking for. */
  .cookieRow__status--accent {
    color: var(--accent);
  }

  .cookieRow__text {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-body);
  }
</style>
