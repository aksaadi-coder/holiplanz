---
import Card from './Card.astro';

/**
 * One pricing tier.
 *
 * "Trip Pass" is the $19 tier's actual product name — not to be confused with
 * the hero's trip pass card, which is a graphic and is labelled "Your trip".
 * Its label is the one place in this section coral is spent.
 */
interface Feature {
  text: string;
  /** Features the tier doesn't include, shown present but muted. */
  muted?: boolean;
}

interface Props {
  tier: string;
  /** Coral is earned here only by the tier being highlighted. */
  tierTone?: 'default' | 'accent';
  price: string;
  priceSuffix?: string;
  features: Feature[];
  featured?: boolean;
}

const {
  tier,
  tierTone = 'default',
  price,
  priceSuffix,
  features,
  featured = false,
} = Astro.props;
---

<Card padding={28} radius={24} featured={featured}>
  <div class="tier">
    <span class:list={['label', { 'tier__label--accent': tierTone === 'accent' }]}>{tier}</span>
    <span class="tier__price">
      {price}
      {priceSuffix && <span class="tier__suffix">{priceSuffix}</span>}
    </span>
  </div>
  <ul class="tier__features">
    {
      features.map((feature) => (
        <li class:list={{ 'tier__feature--muted': feature.muted }}>{feature.text}</li>
      ))
    }
  </ul>
</Card>

<style>
  .tier {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 20px;
  }

  .tier__label--accent {
    color: var(--accent);
  }

  .tier__price {
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 500;
    line-height: 1;
    color: var(--text-primary);
  }

  .tier__suffix {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    color: var(--text-secondary);
  }

  .tier__features {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--text-list);
  }

  /* A locked feature is stated plainly and greyed, never marked as an error —
     skipping is always neutral in this product. */
  .tier__feature--muted {
    color: var(--text-secondary);
  }
</style>
