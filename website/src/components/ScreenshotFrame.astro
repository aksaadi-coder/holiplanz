---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * An app screenshot in its rounded hairline frame.
 *
 * Screenshots are shown whole and uncropped — full width, auto height. An
 * earlier revision cropped them to a fixed height and it was rejected, so
 * there is deliberately no height or object-fit anywhere in here.
 *
 * The screenshots themselves are swappable: they are real exports from the
 * current app build and will be replaced as the app evolves. Keeping them
 * behind this one component makes that a file swap.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /**
   * 340 for the phone screens in the step bands, 400 for the passport.
   * `null` lets the frame fill its grid column, as the four-up cards do.
   */
  maxWidth?: number | null;
  /** 40 on the tall phone frames, 28 on the four-up cards. */
  radius?: number;
  /** Which surface sits behind the image inside the frame. */
  surface?: 'panel' | 'primary';
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  maxWidth = 340,
  radius = 40,
  surface = 'panel',
  loading = 'lazy',
} = Astro.props;

const fluid = maxWidth === null;

// Source exports are 804px wide, so a 2× render of a 340px frame is still
// inside the original — no upscaling at either density.
const widths = fluid ? [400, 804] : [maxWidth, maxWidth * 2];

// The fluid case is the four-up grid: roughly a third of the 1240px column on
// desktop, half the viewport at tablet, near-full on a phone.
const sizes = fluid
  ? '(min-width: 1120px) 300px, (min-width: 760px) 46vw, 92vw'
  : `(max-width: ${maxWidth}px) 100vw, ${maxWidth}px`;
---

<div
  class:list={['frame', `frame--${surface}`, { 'frame--fluid': fluid }]}
  style={`--frame-max:${fluid ? 'none' : `${maxWidth}px`};--frame-radius:${radius}px`}
>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="png"
    loading={loading}
    decoding="async"
  />
</div>

<style>
  .frame {
    width: 100%;
    max-width: var(--frame-max);
    border-radius: var(--frame-radius);
    overflow: hidden;
    border: 1px solid var(--frame-border);
  }

  .frame--panel {
    background: var(--bg-panel);
  }

  .frame--primary {
    background: var(--bg-primary);
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
