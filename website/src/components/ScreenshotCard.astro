---
import type { ImageMetadata } from 'astro';
import ScreenshotFrame from './ScreenshotFrame.astro';

/** A framed screenshot with its caption beneath — the four-up grid's unit. */
interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

const { image, alt, caption } = Astro.props;
---

<figure class="shot">
  <ScreenshotFrame src={image} alt={alt} maxWidth={null} radius={28} surface="primary" />
  <figcaption class="shot__caption">{caption}</figcaption>
</figure>

<style>
  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shot__caption {
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-muted-strong);
  }
</style>
