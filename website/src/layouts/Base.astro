---
import SiteFooter from '../components/SiteFooter.astro';
import { canonicalPath } from '../utils/paths';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Force a single page out of search results. The whole site is already
      excluded while `site.indexable` is false — see the note there. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const hideFromSearch = noindex || !site.indexable;

const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FF4C3F" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Holiplanz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      The token bundle loads fonts with a CSS @import, which is render-blocking
      and can't be preconnected. Same families and weights, hoisted to <link>.
      Newsreader: 400/500 upright + 400 italic (wordmark, pull-quote) + 600
      (the destination stamp). Hanken Grotesk: 400 body, 500 labels, 600
      uppercase labels, 700 stamp sublabel.
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
    />

    {!hideFromSearch && <link rel="sitemap" href="/sitemap-index.xml" />}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main">
      <slot />
    </main>

    {/*
      The closing band and the footer sit inside one dark wrapper so there is
      no seam between them. This was a specific correction during design: the
      page must not stay white to the bottom.
    */}
    <div data-theme="dark" class="page-end">
      <slot name="closing" />
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  /* See the sticky-footer note on body in global.css. */
  .page-end {
    margin-top: auto;
    background: var(--bg-primary);
    color: var(--text-primary);
  }
</style>
