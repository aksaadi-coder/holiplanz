{
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/s", "destination": "/index.html" },
    { "source": "/s/(.*)", "destination": "/index.html" }
  ]
}
